{
  "name": "@shani/ui",
  "version": "0.1.0",
  "description": "Component library for Shani Design System",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "bin": {
    "shani-ds": "./bin/shani-ds.js"
  },
  "files": [
    "dist",
    "bin",
    "components.json",
    "AGENTS.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components.json": "./components.json",
    "./AGENTS.md": "./AGENTS.md",
    "./rules.md": "./AGENTS.md",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('components.json', 'dist/components.json')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest"
  },
  "dependencies": {
    "@shani/tokens": "workspace:*"
  },
  "bundleDependencies": [
    "@shani/tokens"
  ],
  "peerDependencies": {
    "lucide-react-native": "^1.65.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": "~3.16.7",
    "react-native-svg": "^15.16.0",
    "typescript": ">=4.9.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.8.1",
    "@types/react": "^18.3.12",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^18.3.0",
    "lucide-react-native": "^1.65.0",
    "react": "18.3.1",
    "react-native": "^0.76.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-svg": "^15.16.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3"
  }
}
