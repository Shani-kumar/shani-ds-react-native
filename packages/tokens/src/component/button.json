{
  "component": {
    "button": {
      "primary": {
        "bg": { "$value": "{semantic.color.action.primary.default}", "$type": "color" },
        "bgPressed": { "$value": "{semantic.color.action.primary.pressed}", "$type": "color" },
        "bgDisabled": { "$value": "{semantic.color.action.primary.disabled}", "$type": "color" },
        "text": { "$value": "{semantic.color.action.primary.text}", "$type": "color" },
        "textDisabled": {
          "$value": "{semantic.color.action.primary.textDisabled}",
          "$type": "color"
        }
      },
      "secondary": {
        "bg": { "$value": "{semantic.color.action.secondary.default}", "$type": "color" },
        "bgPressed": { "$value": "{semantic.color.action.secondary.pressed}", "$type": "color" },
        "bgDisabled": { "$value": "{semantic.color.action.secondary.disabled}", "$type": "color" },
        "border": { "$value": "{semantic.color.action.secondary.border}", "$type": "color" },
        "borderPressed": {
          "$value": "{semantic.color.action.secondary.borderPressed}",
          "$type": "color"
        },
        "text": { "$value": "{semantic.color.action.secondary.text}", "$type": "color" },
        "textDisabled": {
          "$value": "{semantic.color.action.secondary.textDisabled}",
          "$type": "color"
        }
      },
      "tertiary": {
        "bg": { "$value": "{semantic.color.bg.brand}", "$type": "color" },
        "bgPressed": { "$value": "{semantic.color.bg.brandSubtle}", "$type": "color" },
        "bgDisabled": { "$value": "{semantic.color.bg.muted}", "$type": "color" },
        "text": { "$value": "{semantic.color.text.brand}", "$type": "color" },
        "textDisabled": { "$value": "{semantic.color.text.muted}", "$type": "color" }
      },
      "danger": {
        "bg": { "$value": "{semantic.color.action.danger.default}", "$type": "color" },
        "bgPressed": { "$value": "{semantic.color.action.danger.pressed}", "$type": "color" },
        "bgDisabled": { "$value": "{semantic.color.action.danger.disabled}", "$type": "color" },
        "text": { "$value": "{semantic.color.action.danger.text}", "$type": "color" },
        "textDisabled": {
          "$value": "{semantic.color.action.danger.textDisabled}",
          "$type": "color"
        }
      },
      "ghost": {
        "bg": { "$value": "transparent", "$type": "color" },
        "bgPressed": { "$value": "{semantic.color.bg.subtle}", "$type": "color" },
        "bgDisabled": { "$value": "transparent", "$type": "color" },
        "text": { "$value": "{semantic.color.text.primary}", "$type": "color" },
        "textDisabled": { "$value": "{semantic.color.text.muted}", "$type": "color" }
      },
      "size": {
        "sm": {
          "minHeight": {
            "$value": 44,
            "$type": "dimension",
            "$description": "WCAG minimum 44pt touch target"
          },
          "paddingHorizontal": { "$value": 12, "$type": "dimension" },
          "paddingVertical": { "$value": 8, "$type": "dimension" },
          "gap": { "$value": 6, "$type": "dimension" },
          "fontSize": { "$value": 14, "$type": "dimension" },
          "iconSize": { "$value": 16, "$type": "dimension" }
        },
        "md": {
          "minHeight": {
            "$value": 48,
            "$type": "dimension",
            "$description": "Standard comfortable button height"
          },
          "paddingHorizontal": { "$value": 16, "$type": "dimension" },
          "paddingVertical": { "$value": 12, "$type": "dimension" },
          "gap": { "$value": 8, "$type": "dimension" },
          "fontSize": { "$value": 16, "$type": "dimension" },
          "iconSize": { "$value": 20, "$type": "dimension" }
        },
        "lg": {
          "minHeight": {
            "$value": 56,
            "$type": "dimension",
            "$description": "Large hero and driver-glove friendly button"
          },
          "paddingHorizontal": { "$value": 24, "$type": "dimension" },
          "paddingVertical": { "$value": 16, "$type": "dimension" },
          "gap": { "$value": 10, "$type": "dimension" },
          "fontSize": { "$value": 18, "$type": "dimension" },
          "iconSize": { "$value": 24, "$type": "dimension" }
        }
      }
    }
  }
}
