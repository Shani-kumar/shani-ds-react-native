{
  "shadow": {
    "none": {
      "$value": {
        "shadowColor": "#000000",
        "shadowOffset": { "width": 0, "height": 0 },
        "shadowOpacity": 0,
        "shadowRadius": 0,
        "elevation": 0
      },
      "$type": "shadow",
      "$description": "No elevation or shadow"
    },
    "sm": {
      "$value": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 1 },
        "shadowOpacity": 0.05,
        "shadowRadius": 2,
        "elevation": 1
      },
      "$type": "shadow",
      "$description": "Subtle card or container lift"
    },
    "md": {
      "$value": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 3 },
        "shadowOpacity": 0.1,
        "shadowRadius": 6,
        "elevation": 3
      },
      "$type": "shadow",
      "$description": "Standard interactive element elevation (buttons, active cards)"
    },
    "lg": {
      "$value": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 6 },
        "shadowOpacity": 0.12,
        "shadowRadius": 12,
        "elevation": 6
      },
      "$type": "shadow",
      "$description": "Dropdowns, popovers and floating action buttons"
    },
    "xl": {
      "$value": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 12 },
        "shadowOpacity": 0.16,
        "shadowRadius": 24,
        "elevation": 12
      },
      "$type": "shadow",
      "$description": "Modals, bottom sheets and high overlays"
    }
  }
}
