{
  "motion": {
    "duration": {
      "instant": {
        "$value": 0,
        "$type": "duration",
        "$description": "No animation / reduced motion"
      },
      "fast": {
        "$value": 150,
        "$type": "duration",
        "$description": "Micro-interactions: buttons, switches, checkboxes"
      },
      "normal": {
        "$value": 250,
        "$type": "duration",
        "$description": "Standard transitions: expand/collapse, cards"
      },
      "slow": {
        "$value": 400,
        "$type": "duration",
        "$description": "Major transitions: modals, page sheets"
      },
      "crawl": {
        "$value": 600,
        "$type": "duration",
        "$description": "Progressive multi-step animations"
      }
    },
    "easing": {
      "standard": {
        "$value": [0.2, 0, 0, 1],
        "$type": "cubicBezier",
        "$description": "Standard material cubic bezier"
      },
      "accelerate": {
        "$value": [0.3, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "Elements exiting screen"
      },
      "decelerate": {
        "$value": [0, 0, 0, 1],
        "$type": "cubicBezier",
        "$description": "Elements entering screen"
      },
      "linear": {
        "$value": [0, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "Constant motion like spinners"
      }
    },
    "spring": {
      "default": {
        "$value": { "damping": 20, "mass": 1, "stiffness": 180 },
        "$type": "spring",
        "$description": "Standard natural spring for UI gestures"
      },
      "snappy": {
        "$value": { "damping": 26, "mass": 0.8, "stiffness": 300 },
        "$type": "spring",
        "$description": "Snappy response for switches and chips"
      },
      "bouncier": {
        "$value": { "damping": 14, "mass": 1, "stiffness": 160 },
        "$type": "spring",
        "$description": "Playful accent feedback"
      },
      "gentle": {
        "$value": { "damping": 30, "mass": 1.2, "stiffness": 140 },
        "$type": "spring",
        "$description": "Smooth bottom sheet drag settling"
      }
    }
  }
}
