{
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": "System, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Primary sans-serif font stack for UI"
      },
      "mono": {
        "$value": "Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
        "$type": "fontFamily",
        "$description": "Monospace font stack for tracking codes and coordinates"
      }
    },
    "fontSize": {
      "xs": { "$value": 12, "$type": "dimension", "$description": "Captions and fine print" },
      "sm": {
        "$value": 14,
        "$type": "dimension",
        "$description": "Secondary labels and body compact"
      },
      "base": { "$value": 16, "$type": "dimension", "$description": "Default body reading size" },
      "lg": {
        "$value": 18,
        "$type": "dimension",
        "$description": "Emphasized body and small headings"
      },
      "xl": { "$value": 18, "$type": "dimension", "$description": "Subheadings and card headers" },
      "2xl": { "$value": 24, "$type": "dimension", "$description": "Screen titles and modals" },
      "3xl": {
        "$value": 28,
        "$type": "dimension",
        "$description": "Large metric and dashboard stats"
      },
      "4xl": { "$value": 32, "$type": "dimension", "$description": "Hero display numbers" }
    },
    "lineHeight": {
      "xs": { "$value": 16, "$type": "dimension", "$description": "Line height for xs" },
      "sm": { "$value": 20, "$type": "dimension", "$description": "Line height for sm" },
      "base": { "$value": 24, "$type": "dimension", "$description": "Line height for base" },
      "lg": { "$value": 24, "$type": "dimension", "$description": "Line height for lg" },
      "xl": { "$value": 24, "$type": "dimension", "$description": "Line height for xl" },
      "2xl": { "$value": 32, "$type": "dimension", "$description": "Line height for 2xl" },
      "3xl": { "$value": 36, "$type": "dimension", "$description": "Line height for 3xl" },
      "4xl": { "$value": 40, "$type": "dimension", "$description": "Line height for 4xl" }
    },
    "fontWeight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight",
        "$description": "Standard regular weight"
      },
      "medium": { "$value": "500", "$type": "fontWeight", "$description": "Medium emphasis" },
      "semibold": {
        "$value": "600",
        "$type": "fontWeight",
        "$description": "Semibold headers and buttons"
      },
      "bold": { "$value": "700", "$type": "fontWeight", "$description": "Bold hero headlines" }
    },
    "letterSpacing": {
      "tight": { "$value": -0.4, "$type": "dimension", "$description": "Tight headline spacing" },
      "normal": { "$value": 0, "$type": "dimension", "$description": "Default letter spacing" },
      "wide": {
        "$value": 0.4,
        "$type": "dimension",
        "$description": "Uppercase badges and labels"
      },
      "wider": { "$value": 1, "$type": "dimension", "$description": "Prominent tracking numbers" }
    }
  }
}
