{
  "name": "shani-ds",
  "version": "0.0.1",
  "private": true,
  "description": "Production-style React Native design system for logistics mobile apps",
  "scripts": {
    "dev": "pnpm --filter @shani/gallery dev",
    "build": "pnpm tokens:build && pnpm --filter \"./packages/*\" build",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:drift": "tsx scripts/build-tokens.ts --check",
    "contrast": "tsx scripts/contrast.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
